<Project>
  <!--
    Shared settings for every project in MARTIS.sln.
    Martis.Game is not in this solution, so these settings do not have to
    satisfy the Godot SDK. The engine version is the product version printed
    by the CLI; it is not a scientific parameter.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      packages.lock.json is the cache key for actions/setup-dotnet. CI restores
      in locked mode so that file cannot drift. The implicit NuGet fallback
      folder is disabled because the action caches only the global packages
      folder; leaving the fallback on makes a cache hit fail with NU1403.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <RestoreLockedMode Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <Version>0.1.0</Version>
    <Product>MARTIS</Product>
  </PropertyGroup>
</Project>
