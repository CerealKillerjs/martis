<Project>
  <!--
    Central package versions. The test packages were pinned on 2026-11-15.
    CsCheck 5.0.1 is the latest stable on nuget.org on 2026-11-16.
    Floating versions are intentionally absent. Microsoft.Data.Sqlite 11.0.0
    is the latest stable package and its nuspec targets net10.0.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
